    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "knip": "^6.41.0",
    "prettier": "^3.9.10",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.9.8",
    "typescript": "^6.0.3",
